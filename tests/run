#!/bin/zsh
# Checks everything that needs no aerial videos and changes nothing on the
# system: schedules → anchors, the clock table, the timeline simulation,
# scenes.json itself, and argument handling. All output goes to a temp
# directory; the wallpaper is never set.
#
# What it cannot check is what macOS does with the files. That was
# measured by hand and is written down in docs/solar-selection.md.
#
# Usage: tests/run

set -uo pipefail

ROOT="${0:A:h:h}"
BIN="$ROOT/bin"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# The Swift scripts resolve "~" through this, so pack frames and HEICs
# land in the temp directory instead of ~/Pictures.
export CFFIXED_USER_HOME="$TMP/home"
FRAMES="$TMP/home/Pictures/AerialWallpapers"
mkdir -p "$FRAMES"

failures=0
pass() { print -- "ok    $1" }
fail() { print -- "FAIL  $1"; (( failures += 1 )) }

# expect_status <code> <description> <command...>
expect_status() {
    local want=$1 what=$2; shift 2
    "$@" >"$TMP/out" 2>&1
    local got=$?
    if (( got == want )); then pass "$what"; else fail "$what (exit $got, wanted $want)"; sed 's/^/        /' "$TMP/out"; fi
}
# expect_line <description> <pattern> <text>
expect_line() {
    if print -- "$3" | grep -q -E -- "$2"; then pass "$1"; else fail "$1 (no line matching: $2)"; print -- "$3" | sed 's/^/        /'; fi
}

# A 64×64 stand-in image: the scripts only need something decodable.
print 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==' \
    | base64 -D > "$TMP/pixel.png"
sips -z 64 64 "$TMP/pixel.png" --out "$TMP/frame.png" >/dev/null
IMAGES=("$TMP/frame.png" "$TMP/frame.png" "$TMP/frame.png" "$TMP/frame.png")

print "== solar table from the default schedule"
expect_status 0 "build --images" "$BIN/aerial-build-dynamic.swift" --images $IMAGES --out "$TMP/solar.heic"
inspect="$("$BIN/aerial-inspect" "$TMP/solar.heic")"
expect_line "four frames" '^frames: 4$' "$inspect"
expect_line "light is frame 0, dark is frame 1" 'light → frame 0, dark → frame 1' "$inspect"
expect_line "eight anchors" '^solar:  8 anchors' "$inspect"
# Frame order is day, night, morning, evening. Each switch has an anchor
# 0.5° either side of it: rising ones at azimuth 90, setting ones at 270.
expect_line "night below the dawn switch"   'a=  -7\.5  z=  90\.0  →  1' "$inspect"
expect_line "morning above the dawn switch" 'a=  -6\.5  z=  90\.0  →  2' "$inspect"
expect_line "morning below the day switch"  'a=   9\.5  z=  90\.0  →  2' "$inspect"
expect_line "day above the day switch"      'a=  10\.5  z=  90\.0  →  0' "$inspect"
expect_line "day above the evening switch"  'a=   3\.5  z= 270\.0  →  0' "$inspect"
expect_line "evening below it"              'a=   2\.5  z= 270\.0  →  3' "$inspect"
expect_line "evening above the dusk switch" 'a=  -8\.5  z= 270\.0  →  3' "$inspect"
expect_line "night below the dusk switch"   'a=  -9\.5  z= 270\.0  →  1' "$inspect"

print "== timeline: switches happen at the scheduled sun altitudes"
# On the equator at an equinox the sun moves 0.25° a minute, so the
# altitude printed for the minute of a switch is within 0.3° of it.
timeline="$(TZ=UTC "$BIN/aerial-inspect" "$TMP/solar.heic" --timeline 0,0 --date 2026-03-20 | sed -n '/^timeline/,$p')"
order="$(print -- "$timeline" | awk '/frame/ { printf "%s ", $3 }')"
[[ $order == "1 2 0 3 1 " ]] && pass "night, morning, day, evening, night" || fail "frame order was: $order"
i=0
for want in -7 10 3 -9; do
    (( i += 1 ))
    got="$(print -- "$timeline" | awk '/frame/' | sed -n "$(( i + 1 ))p" | sed -E 's/.*\(sun *(-?[0-9.]+)°\).*/\1/')"
    if (( ${got:-999} > want - 0.3 && ${got:-999} < want + 0.3 )); then pass "switch $i at ${want}° (simulated: ${got}°)"
    else fail "switch $i wanted ${want}°, simulated ${got}°"; fi
done
south="$(TZ=UTC "$BIN/aerial-inspect" "$TMP/solar.heic" --timeline -33.9,0 --date 2026-06-21 | sed -n '/^timeline/,$p' | awk '/frame/ { printf "%s ", $3 }')"
[[ $south == "1 2 0 3 1 " ]] && pass "same order in the southern hemisphere" || fail "southern hemisphere order was: $south"

print "== clock table"
expect_status 0 "build --images --mode time" "$BIN/aerial-build-dynamic.swift" --images $IMAGES --mode time --out "$TMP/clock.heic"
inspect="$("$BIN/aerial-inspect" "$TMP/clock.heic")"
expect_line "midnight entry for the frame shown across it" '00:00  →  1' "$inspect"
expect_line "06:00 morning" '06:00  →  2' "$inspect"
expect_line "11:00 day" '11:00  →  0' "$inspect"
expect_line "17:00 evening" '17:00  →  3' "$inspect"
expect_line "21:00 night" '21:00  →  1' "$inspect"
print -- "$inspect" | grep -q '^solar:' && fail "a clock HEIC must not carry a solar table" || pass "no solar table in a clock HEIC"
expect_status 1 "--timeline refuses a clock HEIC" "$BIN/aerial-inspect" "$TMP/clock.heic" --timeline 0,0

print "== every pack in scenes.json builds in both modes"
n=0
while name="$(plutil -extract "$n.name" raw "$ROOT/scenes.json" 2>/dev/null)"; do
    prefix="${${name:l}// /}"
    for frame in ${(f)"$(plutil -extract "$n.clips" raw "$ROOT/scenes.json")"}; do
        cp "$TMP/frame.png" "$FRAMES/$prefix-$frame.png"
    done
    expect_status 0 "$name, solar" "$BIN/aerial-build-dynamic.swift" --pack "$name"
    expect_status 0 "$name, time" "$BIN/aerial-build-dynamic.swift" --pack "$name" --mode time --out "$TMP/pack-clock.heic"
    (( n += 1 ))
done
(( n > 0 )) && pass "$n packs found" || fail "no packs found in scenes.json"

print "== schedules that cannot work are rejected"
# The scripts read scenes.json from next to bin/, so a copy of bin/ with
# its own scenes.json tests a schedule without touching the real file.
mkdir -p "$TMP/alt/bin"
cp "$BIN/aerial-build-dynamic.swift" "$TMP/alt/bin/"
for frame in day night; do cp "$TMP/frame.png" "$FRAMES/probe-$frame.png"; done
reject() {   # reject <description> <rising> <setting> [clock]
    local clock=${4:+, \"clock\": $4}
    print "[{\"name\": \"Probe\", \"clips\": {\"day\": \"X\", \"night\": \"Y\"}, \"rising\": $2, \"setting\": $3$clock, \"light\": \"day\", \"dark\": \"night\"}]" \
        > "$TMP/alt/scenes.json"
    expect_status 1 "$1" "$TMP/alt/bin/aerial-build-dynamic.swift" --pack Probe --mode ${4:+time}${4:-solar} --out "$TMP/probe.heic"
}
GOOD_R='["night", -3, "day"]'; GOOD_S='["day", 3, "night"]'
print "[{\"name\": \"Probe\", \"clips\": {\"day\": \"X\", \"night\": \"Y\"}, \"rising\": $GOOD_R, \"setting\": $GOOD_S, \"light\": \"day\", \"dark\": \"night\"}]" > "$TMP/alt/scenes.json"
expect_status 0 "a valid two-frame pack builds" "$TMP/alt/bin/aerial-build-dynamic.swift" --pack Probe --out "$TMP/probe.heic"
reject "rising altitudes that do not increase" '["night", 5, "day", -3, "night", 20, "day"]' "$GOOD_S"
reject "setting altitudes closer than the anchors allow" "$GOOD_R" '["day", 3, "night", 2.5, "day", -9, "night"]'
reject "rising that does not hand over to setting" "$GOOD_R" '["night", 3, "day"]'
reject "a frame the pack does not define" '["night", -3, "dusk"]' '["dusk", 3, "night"]'
reject "a clip the schedule never shows" '["night"]' '["night"]'
reject "a schedule that does not alternate frames and altitudes" '["night", "day"]' "$GOOD_S"
print "[{\"name\": \"Probe\", \"clips\": {\"day\": \"X\", \"night\": \"Y\"}, \"rising\": $GOOD_R, \"setting\": $GOOD_S, \"clock\": [\"night\", \"18:00\", \"day\", \"06:00\", \"night\"], \"light\": \"day\", \"dark\": \"night\"}]" > "$TMP/alt/scenes.json"
expect_status 1 "clock times that do not increase" "$TMP/alt/bin/aerial-build-dynamic.swift" --pack Probe --mode time --out "$TMP/probe.heic"
print "[{\"name\": \"Probe\", \"clips\": {\"day\": \"X\", \"night\": \"Y\"}, \"rising\": $GOOD_R, \"setting\": $GOOD_S, \"clock\": [\"night\", \"06:00\", \"day\"], \"light\": \"day\", \"dark\": \"night\"}]" > "$TMP/alt/scenes.json"
expect_status 1 "a clock that does not return to its first frame" "$TMP/alt/bin/aerial-build-dynamic.swift" --pack Probe --mode time --out "$TMP/probe.heic"
print "[{\"name\": \"Probe\", \"clips\": {\"day\": \"X\", \"night\": \"Y\"}, \"rising\": $GOOD_R, \"setting\": $GOOD_S, \"light\": \"day\", \"dark\": \"night\"}]" > "$TMP/alt/scenes.json"
expect_status 1 "--mode time for a pack without a clock" "$TMP/alt/bin/aerial-build-dynamic.swift" --pack Probe --mode time --out "$TMP/probe.heic"

print "== arguments"
expect_status 2 "build: unknown argument" "$BIN/aerial-build-dynamic.swift" --bogus
expect_status 2 "build: unknown mode" "$BIN/aerial-build-dynamic.swift" --images $IMAGES --mode sideways
expect_status 2 "build: --images needs four paths" "$BIN/aerial-build-dynamic.swift" --images "$TMP/frame.png"
expect_status 1 "build: unknown pack" "$BIN/aerial-build-dynamic.swift" --pack Atlantis
expect_status 1 "build: missing image" "$BIN/aerial-build-dynamic.swift" --images $IMAGES[1,3] "$TMP/nope.png" --out "$TMP/x.heic"
expect_status 2 "extract: unknown argument" "$BIN/aerial-extract-frames.swift" --bogus
expect_status 2 "inspect: no file" "$BIN/aerial-inspect"
expect_status 2 "inspect: --date without --timeline" "$BIN/aerial-inspect" "$TMP/solar.heic" --date 2026-03-20
expect_status 2 "inspect: malformed date" "$BIN/aerial-inspect" "$TMP/solar.heic" --timeline 0,0 --date 26-3-20
expect_status 2 "inspect: latitude out of range" "$BIN/aerial-inspect" "$TMP/solar.heic" --timeline 95,0
expect_status 1 "inspect: not a dynamic wallpaper" "$BIN/aerial-inspect" "$TMP/frame.png"
expect_status 2 "list: unknown argument" "$BIN/aerial-list" --bogus
expect_status 2 "install: unknown argument" "$BIN/aerial-install" --bogus
expect_status 2 "install: unknown mode" "$BIN/aerial-install" --mode sideways
expect_status 2 "install: --pack without a value" "$BIN/aerial-install" --pack
expect_status 2 "live: unknown command" "$BIN/aerial-live" sideways

print
if (( failures )); then print "$failures failed"; exit 1; fi
print "all passed"
