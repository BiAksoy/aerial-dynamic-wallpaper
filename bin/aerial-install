#!/bin/zsh
# Re-extracts the pack's poster frames, rebuilds the
# solar-dynamic HEIC, and sets it as the desktop wallpaper. After this
# runs once, macOS rotates the wallpaper natively based on the sun's
# position at your current location — no daemon, no cron.
#
# Usage: aerial-install [--pack <Name>] [--mode solar|time]
#   --pack    Pack name from scenes.json (e.g. "Golden Gate", Tahoe,
#             Sequoia). Default: the newest pack in scenes.json that this
#             Mac's aerial manifest contains.
#   --mode    solar (default) follows the sun. time switches frames at
#             the pack's fixed clock times instead.

set -euo pipefail

PACK=""
MODE="solar"
while (( $# > 0 )); do
    case $1 in
        --pack|--mode)
            (( $# >= 2 )) || { print -u2 -- "$1 requires a value"; exit 2 }
            [[ $1 == --pack ]] && PACK=$2 || MODE=$2
            shift 2 ;;
        *) print -u2 "unknown argument: $1"; exit 2 ;;
    esac
done
# Checked here so a typo does not cost a full extraction first.
[[ $MODE == solar || $MODE == time ]] || { print -u2 "unknown --mode $MODE (use solar or time)"; exit 2 }

BIN_DIR="${0:A:h}"
[[ -n $PACK ]] || PACK=$("$BIN_DIR/aerial-extract-frames.swift" --default-pack)
HEIC="$HOME/Pictures/AerialWallpapers/${PACK// /}-Dynamic.heic"

echo "==> extracting poster frames (pack: $PACK)"
"$BIN_DIR/aerial-extract-frames.swift" --pack "$PACK"

echo "==> building ${MODE}-dynamic HEIC"
"$BIN_DIR/aerial-build-dynamic.swift" --pack "$PACK" --mode "$MODE"

echo "==> setting as desktop wallpaper"
"$BIN_DIR/aerial-set-wallpaper" "$HEIC"

if [[ $MODE == time ]]; then
    cat <<EOF

Done. macOS will now switch frames at the pack's clock times in
scenes.json, in local time. Check them with:
  $BIN_DIR/aerial-inspect "$HEIC"
EOF
    exit 0
fi

cat <<EOF

Done. macOS will now rotate the wallpaper based on the sun's altitude
at your current location.

For travel-aware behavior, ensure Location Services is enabled:
  System Settings → Privacy & Security → Location Services → ON
  …→ System Services (bottom) → "Setting Time Zone": ON

If macOS has no location, it places the sun as seen from the equator at
your time zone's meridian: the frames still rotate, with sunrise and
sunset near 06:00 and 18:00 all year.
EOF
