#!/bin/zsh
# Re-extracts the pack's poster frames, rebuilds the
# solar-dynamic HEIC, and sets it as the desktop wallpaper. After this
# runs once, macOS rotates the wallpaper natively based on the sun's
# position at your current location — no daemon, no cron.

set -euo pipefail

usage() {
    cat <<'EOF'
Build a dynamic wallpaper from an Apple aerial pack and set it as the
desktop wallpaper. macOS then switches its frames by itself.

Usage: aerial-install [--pack <name>] [--mode solar|time] [--keep-frames] [--no-set]

  --pack <name>   Pack from scenes.json: "Golden Gate", Tahoe, Sequoia.
                  Default: the newest pack this Mac's aerial manifest
                  contains. aerial-list shows them.
  --mode <mode>   solar (default) follows the sun; time switches at the
                  pack's fixed clock times.
  --keep-frames   Keep the extracted poster PNGs next to the HEIC.
  --no-set        Build the HEIC but leave the current wallpaper alone.
  -h, --help      Show this help.

Example: aerial-install --pack Tahoe --mode time
EOF
}

PACK=""
MODE="solar"
KEEP_FRAMES=0
SET_WALLPAPER=1
while (( $# > 0 )); do
    case $1 in
        --pack|--mode)
            (( $# >= 2 )) || { print -u2 -- "$1 requires a value"; exit 2 }
            [[ $1 == --pack ]] && PACK=$2 || MODE=$2
            shift 2 ;;
        --keep-frames) KEEP_FRAMES=1; shift ;;
        --no-set) SET_WALLPAPER=0; shift ;;
        -h|--help) usage; exit 0 ;;
        *) print -u2 -- "unknown argument: $1 (see --help)"; exit 2 ;;
    esac
done
# Checked here so a typo does not cost a full extraction first.
[[ $MODE == solar || $MODE == time ]] || { print -u2 "unknown --mode $MODE (use solar or time)"; exit 2 }

BIN_DIR="${0:A:h}"
[[ -n $PACK ]] || PACK=$("$BIN_DIR/aerial-extract-frames" --default-pack)
HEIC="$HOME/Pictures/AerialWallpapers/${PACK// /}-Dynamic.heic"

echo "==> extracting poster frames (pack: $PACK)"
LOG="$(mktemp)"
trap 'rm -f "$LOG"' EXIT
"$BIN_DIR/aerial-extract-frames" --pack "$PACK" | tee "$LOG"

echo "==> building ${MODE}-dynamic HEIC"
"$BIN_DIR/aerial-build-dynamic" --pack "$PACK" --mode "$MODE"

# The frames are only an input to the build, and at 4K they add up to
# about 75 MB a pack. Exactly the files this run wrote are removed.
if (( ! KEEP_FRAMES )); then
    sed -n 's/^wrote //p' "$LOG" | while IFS= read -r frame; do rm -f -- "$frame"; done
fi

if (( ! SET_WALLPAPER )); then
    print "\nBuilt $HEIC. The wallpaper was not changed (--no-set); set it with:"
    print "  $BIN_DIR/aerial-set-wallpaper \"$HEIC\""
    exit 0
fi

echo "==> setting as desktop wallpaper"
"$BIN_DIR/aerial-set-wallpaper" "$HEIC"

if [[ $MODE == time ]]; then
    cat <<EOF

Done. macOS will now switch frames at the pack's clock times in
scenes.json, in local time. Check them with:
  $BIN_DIR/aerial-inspect "$HEIC"
EOF
    exit 0
fi

cat <<EOF

Done. macOS will now rotate the wallpaper based on the sun's altitude
at your current location.

For travel-aware behavior, ensure Location Services is enabled:
  System Settings → Privacy & Security → Location Services → ON
  …→ System Services (bottom) → "Setting Time Zone": ON

If macOS has no location, it places the sun as seen from the equator at
your time zone's meridian: the frames still rotate, with sunrise and
sunset near 06:00 and 18:00 all year.
EOF
