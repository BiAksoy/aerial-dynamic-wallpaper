#!/usr/bin/env swift
// Sets an image, still or dynamic, as the desktop wallpaper on every
// display. It goes through NSWorkspace, so unlike scripting System
// Events it needs no Automation permission.
//
// Usage: aerial-set-wallpaper <image>

import AppKit
import Foundation

func fail(_ message: String, code: Int32 = 1) -> Never {
    FileHandle.standardError.write(Data("\(message)\n".utf8)); exit(code)
}

guard CommandLine.arguments.count == 2 else { fail("usage: aerial-set-wallpaper <image>", code: 2) }
let url = URL(fileURLWithPath: CommandLine.arguments[1]).standardizedFileURL
guard FileManager.default.fileExists(atPath: url.path) else { fail("not found: \(url.path)") }
guard !NSScreen.screens.isEmpty else { fail("no display to set a wallpaper on") }

var failed = 0
for screen in NSScreen.screens {
    do {
        try NSWorkspace.shared.setDesktopImageURL(url, for: screen, options: [:])
    } catch {
        FileHandle.standardError.write(Data("\(screen.localizedName): \(error.localizedDescription)\n".utf8))
        failed += 1
    }
}
if failed > 0 { fail("could not set the wallpaper on \(failed) of \(NSScreen.screens.count) displays") }
print("wallpaper set on \(NSScreen.screens.count) display\(NSScreen.screens.count == 1 ? "" : "s")")
